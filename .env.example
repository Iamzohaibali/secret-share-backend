PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.5wrik4j.mongodb.net/secretshare?appName=Cluster0

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 32-byte hex key used for AES-256-GCM encryption of secret content at rest.
# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_char_hex_string

# Comma separated list of allowed frontend origins
CLIENT_URLS=http://localhost:5173

# Max secrets a single user is allowed to own at once
MAX_SECRETS_PER_USER=100